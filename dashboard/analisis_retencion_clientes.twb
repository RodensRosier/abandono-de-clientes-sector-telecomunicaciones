      <column caption='Buys Via Mail Order' datatype='string' name='[BuysViaMailOrder]' role='dimension' type='nominal' />
      <column caption='Tasa de Churn' datatype='real' name='[Calculation_4666045966938112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Churn] = &apos;Yes&apos; THEN 1 ELSE 0 END) / COUNT([CustomerID])' />
      </column>
      <column caption='Ingresos Mensuales en Riesgo' datatype='real' name='[Calculation_4666045968805890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Churn] = &apos;Yes&apos; THEN [MonthlyRevenue] ELSE 0 END)' />
      </column>
      <column caption='Churn_Binario' datatype='integer' name='[Calculation_4666045977198595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Churn] = &apos;Yes&apos; THEN 1 ELSE 0 END' />
      </column>
